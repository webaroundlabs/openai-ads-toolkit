# Editor defaults, so a contributor's editor does not fight the style checkers.
# The authority is still php-cs-fixer and eslint; this file only stops the
# obvious diffs - tabs, trailing whitespace, missing final newlines.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,json,yml,yaml,tpl}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.php]
indent_size = 4

[Makefile]
indent_style = tab
