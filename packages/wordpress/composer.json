{
    "name": "webaroundlabs/openai-ads-wordpress",
    "description": "Conversion Tracking for OpenAI Ads - WordPress plugin built on the shared toolkit.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "wordpress",
        "openai",
        "openai-ads",
        "conversions-api",
        "pixel",
        "measurement"
    ],
    "homepage": "https://github.com/webaroundlabs/openai-ads-toolkit",
    "require": {
        "php": ">=8.2",
        "webaroundlabs/openai-ads": "^0.1",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "php-stubs/woocommerce-stubs": "^11.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "symlink": true,
                "versions": {
                    "webaroundlabs/openai-ads": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "WebaroundLabs\\OpenAIAds\\WordPress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebaroundLabs\\OpenAIAds\\WordPress\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": [
            "phpstan analyse --no-progress --memory-limit=1G -c phpstan.neon.dist",
            "phpstan analyse --no-progress --memory-limit=1G -c phpstan.tests.neon.dist"
        ],
        "style": "php-cs-fixer fix --dry-run --diff",
        "style:fix": "php-cs-fixer fix",
        "check": [
            "@style",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
